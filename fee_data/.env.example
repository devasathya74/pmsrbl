# Firebase Cloud Firestore Credentials
FIREBASE_API_KEY="your-api-key-here"
FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
FIREBASE_APP_ID="your-app-id"

# School & Portal Settings
SCHOOL_NAME="Police Modern School"
SCHOOL_CODE="PMS-2026"
SCHOOL_PHONE="+91 98765 43210"
SCHOOL_EMAIL="info@policemodernschool.edu.in"
DEFAULT_SESSION="2026-27"

# WhatsApp Business / API Configurations
WHATSAPP_DUPLICATE_PROTECTION_HOURS=24
