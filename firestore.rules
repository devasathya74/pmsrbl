rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && validStudent(request.resource.data);
      allow update: if request.auth != null && validStudent(request.resource.data);
      allow delete: if request.auth != null;
    }
    match /fees/{feeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && validFee(request.resource.data);
      allow update: if request.auth != null && validFee(request.resource.data);
      allow delete: if request.auth != null;
    }
    function validStudent(d) {
      return d.pen is string && d.pen.size() > 0
          && d.name is string && d.name.size() > 0
          && d.serial is number;
    }
    function validFee(d) {
      return d.studentId is string && d.studentId.size() > 0
          && d.month is string
          && d.year is string;
    }
  }
}
